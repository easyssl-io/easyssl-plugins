SUGGEST @ROOT@/A/a.crt
  key: @ROOT@/A/a.key
  test: /opt/httpd/bin/httpd -f @ROOT@/A/httpd.conf -t
  reload: /opt/httpd/bin/httpd -f @ROOT@/A/httpd.conf -k graceful
  `@ROOT@/A/httpd.conf:24` (pid 1000)
